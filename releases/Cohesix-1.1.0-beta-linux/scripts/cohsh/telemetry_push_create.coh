# Author: Lukas Bower
# Purpose: Exercise telemetry ingest create, push, reference fallback, and eviction behaviour.
# Copyright 2026 Lukas Bower
attach queen
telemetry push scripts/cohsh/fixtures/telemetry_push_small.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR seg_id=seg-
cat /queen/telemetry/telemetry-demo/latest
EXPECT OK
EXPECT SUBSTR seg-
telemetry push scripts/cohsh/fixtures/telemetry_push_small.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR seg_id=seg-
telemetry push scripts/cohsh/fixtures/telemetry_push_small.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR seg_id=seg-
telemetry push scripts/cohsh/fixtures/telemetry_push_small.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR seg_id=seg-
telemetry push scripts/cohsh/fixtures/telemetry_push_small.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR seg_id=seg-
cat /queen/telemetry/telemetry-demo/seg/seg-000001
EXPECT ERR
telemetry push scripts/cohsh/fixtures/telemetry_push_oversize.txt --device telemetry-demo
EXPECT OK
EXPECT SUBSTR mode=inline
cat /queen/telemetry/telemetry-demo/latest
EXPECT OK
EXPECT SUBSTR seg-
quit
