# Author: Lukas Bower
# Purpose: Record control actions and verify deterministic replay.
# Copyright 2026 Lukas Bower
attach queen
EXPECT OK
cat /replay/status
EXPECT OK
echo cordon > /host/k8s/node/node-1/cordon
EXPECT OK
echo drain > /host/k8s/node/node-1/drain
EXPECT OK
cat /audit/export
EXPECT OK
echo '{"from":0}' > /replay/ctl
EXPECT OK
cat /replay/status
EXPECT OK
EXPECT SUBSTR "state":"ok"
EXPECT SUBSTR "match":true
EXPECT SUBSTR sequence_fnv1a":"
echo '{"from":999999}' > /replay/ctl
EXPECT ERR
quit
