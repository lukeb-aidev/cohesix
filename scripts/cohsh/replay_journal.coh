# Author: Lukas Bower
# Purpose: Record session-local Queen binds and verify deterministic replay.
# Copyright 2026 Lukas Bower
attach queen
EXPECT OK
cat /replay/status
EXPECT OK
echo '{"id":"replay-bind-1","target":"/queen/ctl","decision":"approve"}' > /actions/queue
EXPECT OK
echo '{"bind":{"from":"/proc/boot","to":"/replay-proof-1"}}' > /queen/ctl
EXPECT OK
cat /replay-proof-1
EXPECT OK
echo '{"id":"replay-bind-2","target":"/queen/ctl","decision":"approve"}' > /actions/queue
EXPECT OK
echo '{"bind":{"from":"/proc/boot","to":"/replay-proof-2"}}' > /queen/ctl
EXPECT OK
cat /replay-proof-2
EXPECT OK
cat /audit/export
EXPECT OK
echo '{"from":0}' > /replay/ctl
EXPECT OK
cat /replay/status
EXPECT OK
EXPECT SUBSTR "state":"ok"
EXPECT SUBSTR "match":true
EXPECT SUBSTR sequence_fnv1a":"
echo '{"from":999999}' > /replay/ctl
EXPECT ERR
quit
