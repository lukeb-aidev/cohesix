<?xml version="1.0" encoding="UTF-8"?>
<!-- Author: Lukas Bower -->
<!-- Purpose: Launch the root Mac-side en8 bootpd supervisor for Pi 4 wired NIC DHCP bring-up. -->
<!-- Copyright 2026 Lukas Bower -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lukasbower.cohesix.en8-bootpd</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/lukasbower/GitHub/cohesix/tools/host-bootpd/start-en8-bootpd.zsh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>COHESIX_BOOTPD_RUNTIME_DIR</key>
		<string>/Users/lukasbower/cohesix/host-bootpd</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/lukasbower/cohesix/host-bootpd/root-launchd.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/lukasbower/cohesix/host-bootpd/root-launchd.err.log</string>
</dict>
</plist>
