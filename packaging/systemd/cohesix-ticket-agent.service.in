# Author: Lukas Bower
# Purpose: Confine durable provider execution and keep delegated credentials out of argv.
# Copyright 2026 Lukas Bower
[Unit]
Description=Cohesix host ticket agent
After=cohesix-gateway.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@STATE@
ExecStart=@PREFIX@/bin/host-ticket-agent --rest-url http://127.0.0.1:8080 --manifest @PREFIX@/config/root_task_resolved.json --policy @PREFIX@/config/coh_policy.toml --cursor @STATE@/agent/cursor.json --execution-journal @STATE@/agent/execution.json --agent-lock @STATE@/agent/agent.lock --provider-evidence-root @STATE@/cas --export-root @STATE@/exports --adapter-root @STATE@/adapters --registry-root @STATE@/models @GPU_AGENT_ARGS@ @FIELD_BUS_AGENT_ARGS@ @EVIDENCE_AGENT_ARGS@
LoadCredential=request_auth:@CREDENTIALS@/request_auth
LoadCredential=delegated_ticket:@CREDENTIALS@/agent_ticket
Environment=HIVE_GATEWAY_REQUEST_AUTH_TOKEN=file:%d/request_auth
Environment=COH_REST_TICKET=file:%d/delegated_ticket
@GPU_AGENT_CREDENTIAL@
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
@AGENT_DEVICE_ISOLATION@
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=@STATE@
LimitCORE=0
TasksMax=128
MemoryMax=512M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cohesix-ticket-agent

[Install]
WantedBy=multi-user.target
