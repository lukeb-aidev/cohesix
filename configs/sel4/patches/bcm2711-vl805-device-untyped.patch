+	device-untypes@600000000 {
+		/*
+		 * Pi 4 U-Boot discovers the VL805 xHCI controller behind PCIe and
+		 * maps BAR0 at 0x600000000. Expose that controller window as a
+		 * device untyped so userspace can rediscover and map xHCI after the
+		 * bootloader quiesces USB for handoff.
+		 */
+		reg = <0x00000006 0x00000000 0x00040000>;
+	};
